# Copia este archivo a .env y completa los valores. Nunca subas .env al repo.
# En Vercel, configura las mismas variables en Project Settings → Environment Variables.

# Proveedor de LLM: OpenRouter (API compatible con OpenAI, se usa el SDK `openai`)
LLM_BASE_URL=https://openrouter.ai/api/v1
# API key de OpenRouter (https://openrouter.ai/keys)
LLM_API_KEY=
# Modelo con el formato de OpenRouter, <proveedor>/<modelo>, tal como aparece en https://openrouter.ai/models
LLM_MODEL=
# Modelo con visión para sílabos escaneados (opcional; si falta se usa LLM_MODEL, que debe aceptar imágenes)
LLM_VISION_MODEL=
# Tope de tokens de salida del LLM (incluye razonamiento). Modelos gratis que razonan mucho necesitan ~20000
LLM_MAX_TOKENS=
# Razonamiento: low (por defecto) | medium | high | off | auto (no enviar el parámetro)
LLM_REASONING=
# Recorte del sílabo antes de enviarlo al LLM (~90 % menos tokens). off = enviar el texto completo
LLM_RECORTE=
